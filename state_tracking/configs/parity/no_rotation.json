{
  "schema_version": 1,
  "models": [
    "mamba3_no_rope"
  ],
  "experiment": {
    "task": "parity",
    "description": "Mamba-3 w/o rotation on parity."
  },
  "model": {
    "n_layers": 1,
    "d_intermediate": 0,
    "tie_embeddings": false,
    "d_state": 64,
    "expand": 2,
    "headdim": 64,
    "rope_fraction": 0.5,
    "mimo_rank": 1,
    "chunk_size": 64
  },
  "training": {
    "steps": 10000,
    "batch_size": 256,
    "micro_batch_size": 64,
    "curriculum_min_length": 3,
    "curriculum_start_max": 40,
    "curriculum_end_max": 160,
    "curriculum_ramp_start_step": 0,
    "curriculum_ramp_steps": 6000,
    "long_sequence_mix_ratio": 0.0,
    "lr": 0.0001,
    "min_lr": 1e-06,
    "warmup_steps": 500,
    "lr_decay_horizon_steps": 16000,
    "cooldown_steps": 1000,
    "scheduler": "cosine",
    "weight_decay": 0.1,
    "grad_clip": 10.0
  },
  "evaluation": {
    "context_length": 224,
    "log_every": 20,
    "eval_every": 100,
    "save_every": 1000,
    "validation_samples": 4096,
    "test_samples": 8192,
    "eval_lengths": [
      160,
      192,
      224
    ]
  },
  "runtime": {
    "output_root": "outputs/parity/no_rotation",
    "precision": "fp32",
    "allow_tf32": false,
    "compile_model": false,
    "device": "cuda",
    "resume": "none"
  },
  "sweep": {
    "d_models": [
      64
    ],
    "learning_rates": [
      0.0001,
      0.00019306977288832496,
      0.0003727593720314938,
      0.0007196856730011514,
      0.0013894954943731374,
      0.0026826957952797246,
      0.005179474679231213,
      0.01
    ],
    "seeds": [
      42,
      43
    ]
  }
}
